# Used by docker-compose.prod.yml. Copy to .env.production, fill in every CHANGE ME, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# This is a different set of variables from .env.example (the local-dev one) — docker-compose.prod.yml
# builds the Postgres connection string, CORS origin and API URL itself from the pieces below,
# rather than taking DATABASE_URL/CORS_ORIGIN/etc. directly, so Postgres/Redis's container-network
# addresses never have to be typed out by hand.

# --- Domains (DNS A records for both must already point at this machine before you start Caddy —
# it requests a Let's Encrypt certificate for each on first boot, and that fails silently/retries
# forever if the domain doesn't resolve here yet) ---
WEB_DOMAIN="app.yourdomain.com"
API_DOMAIN="api.yourdomain.com"
WEB_URL="https://app.yourdomain.com"
API_URL="https://api.yourdomain.com"

# --- Database (CHANGE ME — never reuse the dev defaults in production) ---
POSTGRES_USER="kitchenos"
POSTGRES_PASSWORD="CHANGE-ME-a-real-random-password"
POSTGRES_DB="kitchenos"

# --- Auth (CHANGE ME — generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ---
JWT_ACCESS_SECRET="CHANGE-ME-64-byte-random-hex"
JWT_REFRESH_SECRET="CHANGE-ME-a-different-64-byte-random-hex"

# --- Communication providers (optional — see apps/api/src/config/env.schema.ts; unset means that
# channel's adapter marks messages FAILED with a clear reason instead of silently pretending to send) ---
WHATSAPP_GRAPH_API_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=
