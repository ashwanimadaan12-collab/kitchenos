# --- Database ---
DATABASE_URL="postgresql://kitchenos:kitchenos@localhost:5434/kitchenos?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-byte-random-hex"
JWT_REFRESH_SECRET="replace-with-a-different-64-byte-random-hex"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Rate limiting / brute-force protection ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Minutes east of UTC for bucketing reports by hour / day of week.
# 330 = IST. Change this only for an outlet outside India.
REPORT_UTC_OFFSET_MINUTES=330

# --- Communication providers (all optional — unset means that channel's
# adapter marks messages FAILED with a clear reason instead of sending) ---
WHATSAPP_GRAPH_API_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
